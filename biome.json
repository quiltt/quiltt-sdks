{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/*.gen.ts",
      "!**/*.md",
      "!**/*.yaml",
      "!**/*.yml",
      "!!**/.agents",
      "!!**/.build",
      "!!**/.claude",
      "!!**/.next",
      "!!**/android/build",
      "!!**/coverage",
      "!!**/dist",
      "!!**/generated",
      "!!**/node_modules",
      "!!examples/react-native-expo/android",
      "!!examples/react-native-expo/ios",
      "!!packages/android",
      "!!packages/flutter",
      "!!packages/ios"
    ]
  },
  "overrides": [
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["examples/react-native-expo/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": {
              "level": "error",
              "options": {
                "skip": ["ThemedText"]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "identifierOrder": "natural",
            "groups": [
              ["react", "react/**"],
              ["react-dom", "react-dom/**"],
              ["vue", "vue/**"],
              ["svelte", "svelte/**"],
              ["angular", "angular/**"],
              ["react-native", "react-native/**"],
              ["expo", "expo/**", "expo-*", "expo-*/**"],
              ["next", "next/**"],

              ":BLANK_LINE:",

              ["vitest", "vitest/**"],
              ["@testing-library", "@testing-library/**"],

              ":BLANK_LINE:",

              ":NODE:",

              ["@radix-ui/**"],

              ":PACKAGE:",

              ":BLANK_LINE:",

              "@/**",

              ":BLANK_LINE:",

              ["../../../**"],
              ["../../**"],
              ["../**"],
              ["./**"],

              ":BLANK_LINE:",

              ["**/*.css"]
            ]
          }
        }
      }
    }
  },
  "formatter": {
    "lineWidth": 100,
    "indentWidth": 2,
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useAriaPropsForRole": "off",
        "useSemanticElements": "off",
        "useGenericFontNames": "off"
      },
      "complexity": {
        "noForEach": "off",
        "noCommaOperator": "warn"
      },
      "correctness": {
        "noUnusedImports": "warn",
        "noUnknownFunction": "off"
      },
      "nursery": {
        "useTailwindSortedClasses": "warn"
      },
      "performance": {
        "noAccumulatingSpread": "warn",
        "noDelete": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noParameterAssign": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noExplicitAny": "off",
        "noImplicitAnyLet": "warn",
        "noUnknownAtRules": "off"
      }
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "formatter": {
      "enabled": false
    },
    "experimentalFullSupportEnabled": true
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  }
}
