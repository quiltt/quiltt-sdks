{
  "name": "@quiltt/examples-react-native-expo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "type": "commonjs",
  "scripts": {
    "prebuild": "CI=1 expo prebuild",
    "prebuild:clean": "CI=1 expo prebuild --clean",
    "build": "pnpm run prebuild",
    "build:clean": "pnpm run prebuild:clean",
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test:ios:build": "detox build --configuration ios.sim.debug",
    "test:ios:run": "detox test -c ios.sim.debug",
    "test:ios:run:ci": "detox test --configuration ios.sim.debug --cleanup --headless --record-logs all",
    "test:ios": "pnpm run build && pnpm run test:ios:build && pnpm run test:ios:run",
    "test:android:build": "detox build --configuration android.emulator.debug",
    "test:android:run": "detox test -c android.emulator.debug",
    "test:android:run:ci": "detox test --configuration android.emulator.debug --headless --record-logs all --retries 1",
    "test:android": "pnpm run build && pnpm run test:android:build && pnpm run test:android:run",
    "test:e2e": "pnpm run build && (pnpm run test:ios:build & pnpm run test:android:build & wait) && (pnpm run test:ios:run & pnpm run test:android:run & wait)",
    "test:maestro:connector": "maestro test maestro/connector-flow.yaml",
    "test:maestro:oauth": "maestro test maestro/oauth-callback-flow.yaml",
    "test:maestro": "maestro test maestro",
    "test": "node scripts/test.js",
    "lint": "TIMING=1 biome check src/ e2e/ scripts/ plugins/ --fix",
    "typecheck": "node node_modules/typescript-7/bin/tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.27.0",
    "@config-plugins/detox": "^9.0.0",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.0.3",
    "@quiltt/react-native": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/elements": "^2.2.5",
    "@react-navigation/native": "^7.0.14",
    "expo": "~55.0.0",
    "expo-blur": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-splash-screen": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/jest": "^29.5.14",
    "@types/node": "24.12.2",
    "@types/react": "19.2.18",
    "detox": "20.51.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@7.0.2"
  },
  "private": true
}
