{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "moduleDetection": "force",
    "module": "preserve",
    "noImplicitOverride": true,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
