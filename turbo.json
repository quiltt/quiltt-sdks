{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["prebuild", "^build"],
      "outputs": ["dist/**", ".next/**", "ios/**", "android/**"],
      "env": ["NEXT_PUBLIC_*", "NUXT_PUBLIC_*", "VITE_*"]
    },
    "clean": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "prebuild": {
      "dependsOn": ["^prebuild"],
      "outputs": ["dist/**", ".next/**"],
      "cache": false
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint": {
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test:component": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "dependsOn": ["^test"],
      "outputs": []
    },
    "test:unit": {
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "persistent": true
    }
  }
}
